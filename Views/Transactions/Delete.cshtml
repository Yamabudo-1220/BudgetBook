@model BudgetBook.Models.Transaction

@{
    ViewData["Title"] = "Buchung löschen";
}

<h1>Buchung löschen</h1>

<div class="alert alert-warning">
    Soll diese Buchung wirklich gelöscht werden? Das kann nicht rückgängig gemacht werden.
</div>

<dl class="row">
    <dt class="col-sm-3">Datum</dt>
    <dd class="col-sm-9">@Model.BookingDate.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-3">Typ</dt>
    <dd class="col-sm-9">@(Model.Type == BudgetBook.Models.TransactionType.Income ? "Einnahme" : "Ausgabe")</dd>

    <dt class="col-sm-3">Kategorie</dt>
    <dd class="col-sm-9">@Model.Category?.Name</dd>

    <dt class="col-sm-3">Betrag</dt>
    <dd class="col-sm-9">@Model.Amount.ToString("N2") €</dd>

    <dt class="col-sm-3">Beschreibung</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Endgültig löschen</button>
    <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
</form>