@model BudgetBook.Models.ViewModels.TransactionFormViewModel

@{
    ViewData["Title"] = "Buchung bearbeiten";
}

<h1>Buchung bearbeiten</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id">
            <input type="hidden" asp-for="Id" />
            <partial name="_TransactionForm" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Speichern</button>
                <a asp-action="Index" class="btn btn-secondary">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}