@model BudgetBook.Models.ViewModels.TransactionFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Type" class="form-label"></label>
    <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<BudgetBook.Models.TransactionType>()"></select>
    <span asp-validation-for="Type" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="CategoryId" class="form-label"></label>
    <select asp-for="CategoryId" class="form-select">
        <option value="">-- bitte wählen --</option>
        @foreach (var category in Model.Categories)
        {
            <option value="@category.Id"
                    data-type="@((int)category.Type)"
                    selected="@(category.Id == Model.CategoryId)">
                @category.Name
            </option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Amount" class="form-label"></label>
    <div class="input-group">
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
        <span class="input-group-text">€</span>
    </div>
    <span asp-validation-for="Amount" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="BookingDate" class="form-label"></label>
    <input asp-for="BookingDate" class="form-control" />
    <span asp-validation-for="BookingDate" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <input asp-for="Description" class="form-control" />
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<script>
    (function () {
        var typeSelect = document.getElementById("Type");
        var categorySelect = document.getElementById("CategoryId");
        if (!typeSelect || !categorySelect) return;

        // Alle Optionen einmal merken, damit wir sie später wieder einfügen können.
        var allOptions = Array.prototype.slice.call(categorySelect.options);

        function filterCategories() {
            var selectedType = typeSelect.value;
            var previousValue = categorySelect.value;

            categorySelect.innerHTML = "";

            allOptions.forEach(function (option) {
                var matches = option.value === "" || option.dataset.type === selectedType;
                if (matches) {
                    categorySelect.appendChild(option);
                }
            });

            // Alte Auswahl behalten, wenn sie noch passt – sonst auf Platzhalter zurück.
            var stillExists = allOptions.some(function (o) {
                return o.value === previousValue && o.dataset.type === selectedType;
            });
            categorySelect.value = stillExists ? previousValue : "";
        }

        typeSelect.addEventListener("change", filterCategories);
        filterCategories();
    })();
</script>