@model IEnumerable<BudgetBook.Models.Category>

@{
    ViewData["Title"] = "Kategorien verwalten";
}

<h1>Kategorien verwalten</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Neue Kategorie</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Typ</th>
            <th>Aktiv</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>
                @if (c.Type == BudgetBook.Models.TransactionType.Income)
                {
                    <span class="badge bg-success">Einnahme</span>
                }
                else
                {
                    <span class="badge bg-danger">Ausgabe</span>
                }
            </td>
            <td>@(c.IsActive ? "Ja" : "Nein")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Transactions" asp-action="Index" class="btn btn-secondary">Zurück zu den Buchungen</a>
</div>